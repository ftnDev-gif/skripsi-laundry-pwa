datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      String   @default("kasir") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  phoneNumber String   @unique @map("phone_number") @db.VarChar(20)
  address     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  orders      Order[]

  @@map("customers")
}

model Service {
  id                     Int         @id @default(autoincrement())
  name                   String      @db.VarChar(100)
  unit                   String      @db.VarChar(20) // kg, pcs, m2
  price                  Decimal     @db.Decimal(10, 2)
  estimatedDurationHours Int         @default(24) @map("estimated_duration_hours")
  createdAt              DateTime    @default(now()) @map("created_at")
  orderItems             OrderItem[]

  @@map("services")
}

model Order {
  id                      Int               @id @default(autoincrement())
  invoiceCode             String            @unique @map("invoice_code") @db.VarChar(50)
  customerId              Int               @map("customer_id")
  totalPrice              Decimal           @map("total_price") @db.Decimal(10, 2)
  paymentStatus           String            @default("unpaid") @map("payment_status") @db.VarChar(20) // unpaid / paid
  orderStatus             String            @default("antre") @map("order_status") @db.VarChar(30) // antre, dicuci, disetrika, siap_diambil, selesai
  qrCodePath              String?           @map("qr_code_path") @db.VarChar(255)
  entryDate               DateTime          @default(now()) @map("entry_date")
  estimatedCompletionDate DateTime?         @map("estimated_completion_date")
  pickedUpAt              DateTime?         @map("picked_up_at")
  notes                   String?           @db.Text // Catatan fisik pakaian awal
  customer                Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItems              OrderItem[]
  notificationLogs        NotificationLog[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  serviceId Int     @map("service_id")
  quantity  Decimal @db.Decimal(8, 2)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id])

  @@map("order_items")
}

model NotificationLog {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  recipientPhone  String   @map("recipient_phone") @db.VarChar(20)
  messageContent  String   @map("message_content") @db.Text
  status          String   @db.VarChar(20) // queued, sent, failed
  gatewayResponse String?  @map("gateway_response") @db.Text
  sentAt          DateTime @default(now()) @map("sent_at")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("notification_logs")
}